# Backend database connection.
DATABASE_URL=postgresql+asyncpg://newscraft:newscraft@localhost:5432/newscraft

# Browser Settings use server-owned local-owner policy in loopback deployments.
# Set profile only when a profile-session resolver is available.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APPLICATION_AUTH_MODE=local_owner
SECURITY_CODEX_TOKEN=
SECURITY_CODEX_SCOPES=settings:read,providers:read,destinations:read,prompts:read,automations:read,jobs:read
SECURITY_INTERNAL_TOKEN=
SECURITY_INTERNAL_SCOPES=jobs:read,jobs:write,providers:read,destinations:read

# Codex Gateway credential hashing. Generate URL-safe base64 for 32 random bytes.
CODEX_GATEWAY_HASH_KEY=
CODEX_GATEWAY_PUBLIC_URL=http://localhost:8000

# AES-256-GCM secret persistence. Local `.venv` runs read SECRET_MASTER_KEY;
# Compose mounts the stable file selected by SECRET_MASTER_KEY_FILE. Value is
# URL-safe base64 for exactly 32 random bytes. Never replace it automatically.
# Previous keys is optional JSON: {"v0":"<base64-key>"} during rotation.
SECRET_KEY_VERSION=v1
SECRET_MASTER_KEY=
SECRET_PREVIOUS_KEYS=
SECRET_MASTER_KEY_FILE=./secrets/SECRET_MASTER_KEY
SECRET_PREVIOUS_KEYS_FILE=./secrets/SECRET_PREVIOUS_KEYS

# Media download/storage root used by the backend worker.
MEDIA_ROOT=/data/media
EXPORT_ROOT=/data/exports
TELEGRAM_MEDIA_STAGING_ROOT=/data/media-staging
TELEGRAM_PROXY_ALLOWED_PORTS=80,443,1080,3128,8080,8443
TELEGRAM_PROXY_CONNECT_TIMEOUT_SECONDS=10
TELEGRAM_API_READ_TIMEOUT_SECONDS=30

# Optional deployment-level readiness gates. Worker loss always appears in
# operational health; only listed capabilities make API readiness return 503.
READINESS_REQUIRED_CAPABILITIES=
CAPABILITY_QUEUE_CEILING=1000
CAPABILITY_RETRY_AFTER_SECONDS=5
CAPABILITY_OBSERVATION_TTL_SECONDS=120
WORKER_HEALTH_FRESH_SECONDS=60
WORKER_HEALTH_UNAVAILABLE_SECONDS=120
SCHEDULER_HEALTH_FRESH_SECONDS=45
SCHEDULER_HEALTH_UNAVAILABLE_SECONDS=90
JOB_STUCK_SECONDS=900

# Capability-scoped automation workers resolve only references selected in the UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Disabled by default. Enabling requires a worker-only mounted age recipient
# file and a private writable quarantine volume; plaintext is never written.
GENERATION_INVALID_OUTPUT_QUARANTINE_ENABLED=false
GENERATION_INVALID_OUTPUT_QUARANTINE_ROOT=/data/generation-invalid-output
GENERATION_INVALID_OUTPUT_QUARANTINE_RECIPIENT_FILE=/run/secrets/GENERATION_QUARANTINE_AGE_RECIPIENT
GENERATION_INVALID_OUTPUT_QUARANTINE_MAX_BYTES=1000000
GENERATION_INVALID_OUTPUT_QUARANTINE_TTL_DAYS=7
TELEGRAM_SOURCE_EDITOR_API_ID=
TELEGRAM_SOURCE_EDITOR_API_HASH=
TELEGRAM_SOURCE_EDITOR_SESSION=
TELEGRAM_DESTINATION_NEWS_TOKEN=

# Optional normalized outbound proxy policy. Unset, empty, and whitespace-only
# proxy values are direct mode. Use uppercase names; unequal non-empty lowercase
# duplicates are rejected. Docker reaches host-local proxies through
# host.docker.internal, not 127.0.0.1.
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1

# Only needed with docker-compose.proxy.yml when the proxy is attached to a
# separate external Docker network.
XRAY_PROXY_NETWORK=contenthub_default

# Production docker-compose.production.yml secret-file sources. These files
# are mounted only into the owning process at /run/secrets/<REFERENCE>.
CODEX_GATEWAY_HASH_KEY_FILE=./secrets/CODEX_GATEWAY_HASH_KEY
OPENROUTER_API_KEY_FILE=./secrets/OPENROUTER_API_KEY
TELEGRAM_SOURCE_EDITOR_API_ID_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_API_ID
TELEGRAM_SOURCE_EDITOR_API_HASH_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_API_HASH
TELEGRAM_SOURCE_EDITOR_SESSION_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_SESSION
TELEGRAM_DESTINATION_NEWS_TOKEN_FILE=./secrets/TELEGRAM_DESTINATION_NEWS_TOKEN
SOURCE_HTTP_PROXY_FILE=./secrets/source/HTTP_PROXY
SOURCE_HTTPS_PROXY_FILE=./secrets/source/HTTPS_PROXY
SOURCE_ALL_PROXY_FILE=./secrets/source/ALL_PROXY
PUBLISHING_HTTP_PROXY_FILE=./secrets/publishing/HTTP_PROXY
PUBLISHING_HTTPS_PROXY_FILE=./secrets/publishing/HTTPS_PROXY
PUBLISHING_ALL_PROXY_FILE=./secrets/publishing/ALL_PROXY
INGESTION_SOURCE_CONCURRENCY=8
SOURCE_ICON_DISCOVERY_BATCH_SIZE=25
SOURCE_ICON_DISCOVERY_TTL_DAYS=30
SOURCE_ICON_DISCOVERY_RETRY_BASE_SECONDS=3600
SOURCE_ICON_DISCOVERY_RETRY_MAX_SECONDS=604800
SOURCE_ICON_DISCOVERY_TIMEOUT_SECONDS=10
SOURCE_ICON_DISCOVERY_MAX_BYTES=2000000
SOURCE_ICON_DISCOVERY_MAX_REDIRECTS=5
CONTINUOUS_INGESTION_INTERVAL_MINUTES=15
