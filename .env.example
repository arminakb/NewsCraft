# Backend database connection.
DATABASE_URL=postgresql+asyncpg://newscraft:newscraft@localhost:5432/newscraft

# Media download/storage root used by the backend worker.
MEDIA_ROOT=/data/media
TELEGRAM_MEDIA_STAGING_ROOT=/data/media-staging

# Capability-scoped automation workers resolve only references selected in the UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_SOURCE_EDITOR_API_ID=
TELEGRAM_SOURCE_EDITOR_API_HASH=
TELEGRAM_SOURCE_EDITOR_SESSION=
TELEGRAM_DESTINATION_NEWS_TOKEN=

# Optional proxy for public feed access. For Docker Compose, point host-local
# proxies at host.docker.internal instead of 127.0.0.1.
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1
