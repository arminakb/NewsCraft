# Backend database connection.
DATABASE_URL=postgresql+asyncpg://newscraft:newscraft@localhost:5432/newscraft

# Media download/storage root used by the backend worker.
MEDIA_ROOT=/data/media

# Optional proxy for public feed access. For Docker Compose, point host-local
# proxies at host.docker.internal instead of 127.0.0.1.
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1

# Content-production provider pilot. Search remains disabled unless explicitly enabled.
ARTICLE_FETCH_TIMEOUT_SECONDS=15
ARTICLE_FETCH_MAX_BYTES=2000000
ARTICLE_FETCH_MAX_REDIRECTS=4
ENRICHMENT_PROVIDER=none
ENRICHMENT_TIMEOUT_SECONDS=10
ENRICHMENT_MAX_RESULTS=5
ENRICHMENT_MAX_SNIPPET_CHARS=500

# One-pass Persian structured generation. Keep disabled for automated/local tests.
LLM_PROVIDER=none
LLM_MODEL=gpt-5-mini
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1800
LLM_BASE_URL=https://api.openai.com/v1
# Required only when LLM_PROVIDER=openai. Keep the example empty.
OPENAI_API_KEY=
# For OpenRouter Chat Completions, set LLM_PROVIDER=openrouter,
# LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=openai/gpt-5-mini,
# and provide OPENROUTER_API_KEY only through the local process environment.
OPENROUTER_API_KEY=
