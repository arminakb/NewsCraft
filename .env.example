# Backend database connection.
DATABASE_URL=postgresql+asyncpg://newscraft:newscraft@localhost:5432/newscraft

# Media download/storage root used by the backend worker.
MEDIA_ROOT=/data/media
EXPORT_ROOT=/data/exports
TELEGRAM_MEDIA_STAGING_ROOT=/data/media-staging

# Optional deployment-level readiness gates. Worker loss always appears in
# operational health; only listed capabilities make API readiness return 503.
READINESS_REQUIRED_CAPABILITIES=
CAPABILITY_QUEUE_CEILING=1000
CAPABILITY_RETRY_AFTER_SECONDS=5
CAPABILITY_OBSERVATION_TTL_SECONDS=120
WORKER_HEALTH_FRESH_SECONDS=60
WORKER_HEALTH_UNAVAILABLE_SECONDS=120
SCHEDULER_HEALTH_FRESH_SECONDS=45
SCHEDULER_HEALTH_UNAVAILABLE_SECONDS=90
JOB_STUCK_SECONDS=900

# Capability-scoped automation workers resolve only references selected in the UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_SOURCE_EDITOR_API_ID=
TELEGRAM_SOURCE_EDITOR_API_HASH=
TELEGRAM_SOURCE_EDITOR_SESSION=
TELEGRAM_DESTINATION_NEWS_TOKEN=

# Optional normalized outbound proxy policy. Unset, empty, and whitespace-only
# proxy values are direct mode. Use uppercase names; unequal non-empty lowercase
# duplicates are rejected. Docker reaches host-local proxies through
# host.docker.internal, not 127.0.0.1.
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1

# Only needed with docker-compose.proxy.yml when the proxy is attached to a
# separate external Docker network.
XRAY_PROXY_NETWORK=contenthub_default

# Production docker-compose.production.yml secret-file sources. These files
# are mounted only into the owning worker at /run/secrets/<REFERENCE>.
OPENROUTER_API_KEY_FILE=./secrets/OPENROUTER_API_KEY
TELEGRAM_SOURCE_EDITOR_API_ID_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_API_ID
TELEGRAM_SOURCE_EDITOR_API_HASH_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_API_HASH
TELEGRAM_SOURCE_EDITOR_SESSION_FILE=./secrets/TELEGRAM_SOURCE_EDITOR_SESSION
TELEGRAM_DESTINATION_NEWS_TOKEN_FILE=./secrets/TELEGRAM_DESTINATION_NEWS_TOKEN
SOURCE_HTTP_PROXY_FILE=./secrets/source/HTTP_PROXY
SOURCE_HTTPS_PROXY_FILE=./secrets/source/HTTPS_PROXY
SOURCE_ALL_PROXY_FILE=./secrets/source/ALL_PROXY
PUBLISHING_HTTP_PROXY_FILE=./secrets/publishing/HTTP_PROXY
PUBLISHING_HTTPS_PROXY_FILE=./secrets/publishing/HTTPS_PROXY
PUBLISHING_ALL_PROXY_FILE=./secrets/publishing/ALL_PROXY
